{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/marrow-launch.cjs\" cursor-pre-action-hook",
        "matcher": "Write|Delete|Task|Read|Glob|Grep|Search|WebSearch|List|[\\s\\S]*MCP:[\\s\\S]*",
        "timeout": 15,
        "failClosed": true,
        "async": false
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/marrow-launch.cjs\" cursor-hook",
        "matcher": "Shell|Write|Delete|Task|Read|Glob|Grep|Search|WebSearch|List|[\\s\\S]*MCP:[\\s\\S]*",
        "timeout": 5
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/marrow-launch.cjs\" cursor-hook",
        "matcher": "Shell|Write|Delete|Task|Read|Glob|Grep|Search|WebSearch|List|[\\s\\S]*MCP:[\\s\\S]*",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/marrow-launch.cjs\" cursor-session-hook",
        "timeout": 3
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/marrow-launch.cjs\" cursor-pre-action-hook",
        "timeout": 15,
        "failClosed": true,
        "async": false
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/marrow-launch.cjs\" cursor-pre-action-hook",
        "timeout": 15,
        "failClosed": true,
        "async": false
      }
    ],
    "afterShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/marrow-launch.cjs\" cursor-hook",
        "timeout": 5
      }
    ],
    "afterMCPExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/marrow-launch.cjs\" cursor-hook",
        "timeout": 5
      }
    ],
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/marrow-launch.cjs\" cursor-session-hook",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/marrow-launch.cjs\" cursor-context-hook",
        "timeout": 5
      }
    ]
  }
}
